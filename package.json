{
    "name": "greektrainer",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "run-p type-check \"build-only {@}\" --",
        "build:android": "vite build --mode capacitor",
        "build:capacitor": "vue-tsc --build && vite build --mode capacitor && npx cap sync android",
        "capacitor:sync": "npx cap sync android",
        "capacitor:open": "npx cap open android",
        "preview": "vite preview",
        "build-only": "vite build",
        "type-check": "vue-tsc --build",
        "test": "vitest",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist"
    },
    "dependencies": {
        "@capacitor-community/native-audio": "^8.0.0",
        "@capacitor/android": "^8.4.1",
        "@capacitor/cli": "^8.4.1",
        "@capacitor/core": "^8.4.1",
        "@capacitor/local-notifications": "^8.3.1",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/splash-screen": "^8.0.2",
        "@ionic/vue": "^8.8.19",
        "@ionic/vue-router": "^8.8.19",
        "@vueuse/core": "^14.3.0",
        "@vueuse/head": "^2.0.0",
        "idb": "^8.0.3",
        "lucide-vue-next": "^1.0.0",
        "vue": "^3.5.38",
        "vue-i18n": "^9.14.5",
        "vue-router": "^4.6.4"
    },
    "devDependencies": {
        "@capacitor/assets": "^3.0.5",
        "@tsconfig/node24": "^24.0.4",
        "@types/node": "^24.13.3",
        "@vitejs/plugin-vue": "^6.0.7",
        "@vue/test-utils": "^2.4.11",
        "@vue/tsconfig": "^0.9.1",
        "gh-pages": "^6.3.0",
        "jsdom": "^28.1.0",
        "npm-run-all2": "^9.0.2",
        "terser": "^5.48.0",
        "typescript": "~6.0.0",
        "vite": "^8.0.16",
        "vite-plugin-compression2": "^2.5.3",
        "vite-plugin-pwa": "^1.3.0",
        "vite-plugin-vue-devtools": "^8.1.2",
        "vitest": "^4.1.10",
        "vue-tsc": "^3.3.5"
    },
    "engines": {
        "node": "^22.18.0 || >=24.12.0"
    }
}
